# Fortivex AI - Autonomous AI Sales Voice Agent Configuration
APP_NAME=Fortivex AI Sales Voice Agent
APP_ENV=development
DEBUG=true

# Demo Mode vs Live AI Mode
# When DEMO_MODE=true or no OPENAI_API_KEY is set, the system runs in deterministic Demo Mode
# with local RAG embeddings, local sentiment/intent analysis, and contextual sales responses.
DEMO_MODE=true

# Security & JWT
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (SQLite for MVP; PostgreSQL URL supported for production)
DATABASE_URL=sqlite:///./fortivex.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fortivex

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional External AI Provider (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Company & Agent Persona Settings
COMPANY_NAME=Fortivex Cloud Solutions
AGENT_NAME=Aria
DEFAULT_LANGUAGE=en
